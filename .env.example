# ---------------------------------------------------------------------------
# KONSENA AI — environment template (PLACEHOLDERS ONLY, never real secrets)
#
# Copy to `.env` for shell-based builds, or better, copy
# `tool/env/dev.example.json` to `tool/env/dev.json` and build with
#   flutter run --dart-define-from-file=tool/env/dev.json
#
# Guest-first default: leave EVERYTHING below empty/absent and the app starts
# normally in guest mode with cloud status `cloudNotConfigured`.
# ---------------------------------------------------------------------------

# Supabase project URL, https only. Find it in Dashboard > Connect > Project URL.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Publishable (anon) client key. Safe in an APK ONLY because every table and
# the konsena-private bucket are protected by RLS.
# Legacy shape (JWT) is accepted if your project still issues one; the SDK in
# this repo (supabase_flutter 2.18.x) is initialised with `publishableKey`.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_YOUR_PUBLISHABLE_KEY
# SUPABASE_ANON_KEY=eyJ...           # legacy alternative, only if needed

# Master opt-in for cloud sync. DEFAULT IS false and must stay false until
# Phase 07 (login + explicit consent + record selection) is complete.
ENABLE_CLOUD_SYNC=false

# ONNX / on-device ML. DEFAULT IS false until Phase 09 validates the model.
ENABLE_ML=false

# Demo fixtures. Keep false for anything resembling a release build.
ENABLE_DEMO=false

# Optional, only if a backend is ever used. Never blocks local auditing.
API_BASE_URL=
