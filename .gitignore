# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# ---------------------------------------------------------------------------
# KONSENA AI — secrets & environment (PRD §3.3, Phase 00 security contract)
# ---------------------------------------------------------------------------
# Local env files: only the placeholder template may be committed.
.env*
!.env.example
.envrc

# dart-define JSON: keep examples, ignore real values.
tool/env/*.json
!tool/env/*.example.json

# Operator credential scratch file. It holds a database password, a secret key
# and a personal access token — it must NEVER enter Git history.
Kredensial.md
kredensial.md
credentials*.md
secrets*.md

# Key material of any kind.
*.pem
*.p12
*.jks
*.keystore
*.key
*.p8
service-account*.json
*-service-account*.json
supabase/service-*.json

# Supabase CLI local runtime state (holds local stack credentials/ports).
supabase/.temp/
supabase/.env
supabase/.branches/

# Never commit a filled-in dart-define bundle or release keystores.
**/dart-defines*.json
**/release-dart-defines*
/android/key.properties
/android/app/upload-keystore.jks
/android/app/*.jks

# Large ONNX model weights (>100MB) exceed GitHub's hard file-size limit.
# Keep small models (dark_pattern) tracked; the rest live outside git.
model/consentgap/consentgap_5class_fp32.onnx
model/consent_nli/consent_nli/consent_nli_fp32.onnx
model/consent_nli/consent_nli/consent_nli_int8.onnx
model/privacy_classifier/privacy_classifier/privacy_classifier_fp32.onnx
model/privacy_classifier/privacy_classifier/privacy_classifier_int8.onnx
